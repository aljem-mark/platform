# Production configuration template for a public domain (e.g. wedid.work).
#
# HOW TO USE ON THE SERVER
#   1. git pull (this branch), then copy this file:
#        cp dev/docker-compose.prod-template.yaml dev/docker-compose.override.yaml
#      `docker-compose.override.yaml` is auto-loaded by Compose, is gitignored
#      in this directory pattern, and must never be committed with real values.
#   2. Replace every REPLACE_ME_* with a real value:
#        openssl rand -hex 32
#   3. SERVER_SECRET: generate ONE value and use the SAME string on all seven
#      token-verifying services below (account, stats, workspace_cockroach,
#      front, transactor_cockroach, fulltext_cockroach, rating_cockroach).
#      A mismatch invalidates token verification and logs everyone out / 401s.
#   4. Bring the stack up (Compose merges per-key; no !override tags here):
#        docker compose -f docker-compose.yaml -f docker-compose.min.yaml up -d --force-recreate
#   5. Verify:
#        curl -s https://<domain>/config.json | grep -c huly.local   # -> 0
#        curl -s -o /dev/null -w '%{http_code}\n' https://<domain>/branding.json   # -> 200
#
# NOTES
#   * Browser-facing URLs below must match your reverse-proxy routing
#     (see dev/nginx-wedid.work.conf template).
#   * DOC_MODE gates /api/docs + /api/openapi.yaml: off (unset) -> 404,
#     safe -> consumer spec, all -> full spec. Omit for public fail-closed.
#   * Changing SERVER_SECRET invalidates existing sessions and previously
#     minted API tokens: users re-login once; recreate API tokens afterwards.
#   * MinIO AWS_* credentials are intentionally NOT overridden here — they must
#     match the MinIO container's own credentials. Rotate as a separate change.

services:
  # ---- Browser-facing config for the front service (delivered via /config.json) ----
  front:
    environment:
      - SERVER_SECRET=2be5d8705bbfcac7d6e682f1a652654c25719c685453c0775fd9e3cb3f3f3d4a
      - DOC_MODE=safe
      - ACCOUNTS_URL=https://wedid.work/_accounts
      - ACCOUNTS_URL_INTERNAL=http://account:3000
      - COLLABORATOR_URL=wss://wedid.work/collaborator
      - FILES_URL=https://wedid.work/files/:workspace/:blobId/:filename
      - UPLOAD_URL=/files
      - BRANDING_URL=https://wedid.work/branding.json
      - REKONI_URL=https://wedid.work/rekoni
      - DATALAKE_URL=https://wedid.work/datalake
      - STREAM_URL=https://wedid.work/stream/recording
      # --- remaining browser-facing vars: blanked by default ---
      # A URL must only be set for a service that is actually running.
      # preview/link-preview/hulypulse are `profiles: ["full"]` in
      # dev/docker-compose.min.yaml, so they do NOT start under the default
      # `-f docker-compose.yaml -f docker-compose.min.yaml up` (no --profile full).
      # Blank = the client disables the feature instead of fetching a dead path.
      # If you deploy with `--profile full`, set these instead:
      #   PREVIEW_URL=https://wedid.work/preview
      #   LINK_PREVIEW_URL=https://wedid.work/link-preview
      #   PULSE_URL=wss://wedid.work/pulse/ws
      #   HULYLAKE_URL=https://wedid.work/hulylake   (hulylake has no profile -> always runs)
      - PREVIEW_URL=https://wedid.work/preview
      - LINK_PREVIEW_URL=https://wedid.work/link-preview
      - PULSE_URL=wss://wedid.work/pulse/ws
      - HULYLAKE_URL=https://wedid.work/hulylake
      # Integrations with no service in this stack: empty disables them client-side.
      - GMAIL_URL=
      - CALENDAR_URL=
      - TELEGRAM_URL=
      - PAYMENT_URL=
      # extraConfig vars merged into /config.json (pods/front/src/__start.ts:29-59).
      # Blanked: their services are not exposed through the proxy. Set real
      # https://wedid.work/<path> values only if you add matching nginx locations.
      - GITHUB_URL=
      - SIGN_URL=https://wedid.work/sign
      - PRINT_URL=https://wedid.work/print
      - STATS_URL=https://wedid.work/stats
      - BACKUP_URL=https://wedid.work/backup/api/backup
      - EXPORT_URL=https://wedid.work/export
      # Clean feature-off signal for the unused integrations (see docs/disableFeatures.md).
      # NOTE: do NOT add `integration` here — it would also disable sign/print/export,
      # which this stack runs.
      - DISABLED_FEATURES=auto-translate,mailboxes,calendar,telegram

  # ---- Shared token-signing secret: SAME value on all seven services ----
  account:
    environment:
      - SERVER_SECRET=2be5d8705bbfcac7d6e682f1a652654c25719c685453c0775fd9e3cb3f3f3d4a
  stats:
