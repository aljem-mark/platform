# ─────────────────────────────────────────────────────────────────────────────
# dev/.env.example — environment for dev/docker-compose.yaml (the self-hosted stack)
#
#   LOCAL RUN:  cp dev/.env.example dev/.env      then replace every REPLACE_ME_*
#   DEPLOY:     bash scripts/generate-prod-config.sh --domain <your-domain>
#               (generates the shared secret, substitutes the domain and prompts
#                for the mail-provider key; keeps an existing secret unless
#                --rotate-secret is passed)
#
# Compose loads `dev/.env` automatically when you run from `dev/` (e.g.
# `rush docker:up:min`). That file is GITIGNORED — never commit it.
#
# Two kinds of value below:
#   * *_INTERNAL_URL — container-to-container, uses compose service names. The
#     same values work locally and on a server.
#   * *_PUBLIC_URL / HULY_DOMAIN — what the BROWSER and the reverse proxy use.
#     On a server these must become https://<domain>/... (nginx routes them).
# ─────────────────────────────────────────────────────────────────────────────

# --- databases / storage (local defaults; cockroach runs --insecure here) ---
DB_CR_URL=postgresql://root@cockroach:26257/defaultdb?sslmode=disable
STORAGE_CONFIG="datalake|http://datalake:4030"
# Must match the MinIO container's own credentials (compose: minioadmin/minioadmin).
# Change both together if you rotate MinIO.
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=minioadmin&secretKey=minioadmin"
BACKUP_BUCKET_NAME=backups
# Only used by the PostgreSQL overlay (docker-compose.pg.yaml):
DB_URL_PG=postgres://postgres:postgres@postgres:5432/postgres
# Legacy mongo-backed tooling; there is no mongo service in this stack:
MONGO_URL=mongodb://mongodb:27017?compressors=snappy

# --- queue / cache ---
QUEUE_CONFIG=redpanda:9092
QUEUE_REGION=cockroach
REDIS_URL=redis://redis:6379

# --- internal service URLs (same locally and on the server) ---
ACCOUNT_INTERNAL_URL=http://account:3000
STATS_INTERNAL_URL=http://stats:4900
TRANSACTOR_INTERNAL_URL=ws://transactor_cockroach:3332
# Fulltext listens on 4702 (its PORT in docker-compose.yaml) — not 4700.
FULLTEXT_INTERNAL_URL=http://fulltext_cockroach:4702
DATALAKE_INTERNAL_URL=http://datalake:4030
REKONI_INTERNAL_URL=http://rekoni:4004
HULYLAKE_INTERNAL_URL=http://hulylake:8096
ELASTIC_INTERNAL_URL=http://elastic:9200
STREAM_DATALAKE_URL=datalake://datalake:4030

# --- shared token-signing secret ---
# ONE value, used by every token-verifying service (account, front, workspace,
# stats, transactor, fulltext, rating). Keep it STABLE across redeploys: changing
# it logs every user out and invalidates all previously minted API tokens.
# Generate with: openssl rand -hex 32
HULY_SHARED_SECRET=REPLACE_ME_HULY_SHARED_SECRET

# --- public identity (browser + reverse proxy) ---
HULY_DOMAIN=REPLACE_ME_DOMAIN
HULY_PUBLIC_URL=https://REPLACE_ME_DOMAIN
ACCOUNT_PUBLIC_URL=https://REPLACE_ME_DOMAIN/_accounts
TRANSACTOR_PUBLIC_URL=wss://REPLACE_ME_DOMAIN/_transactor
COLLABORATOR_PUBLIC_URL=wss://REPLACE_ME_DOMAIN/collaborator
FILES_PUBLIC_URL=https://REPLACE_ME_DOMAIN/files/:workspace/:blobId/:filename
DATALAKE_PUBLIC_URL=https://REPLACE_ME_DOMAIN/datalake
HULYLAKE_PUBLIC_URL=https://REPLACE_ME_DOMAIN/hulylake
PULSE_PUBLIC_URL=wss://REPLACE_ME_DOMAIN/pulse/ws
STATS_PUBLIC_URL=https://REPLACE_ME_DOMAIN/stats
REKONI_PUBLIC_URL=https://REPLACE_ME_DOMAIN/rekoni
PREVIEW_PUBLIC_URL=https://REPLACE_ME_DOMAIN/preview
LINK_PREVIEW_PUBLIC_URL=https://REPLACE_ME_DOMAIN/link-preview
PRINT_PUBLIC_URL=https://REPLACE_ME_DOMAIN/print
SIGN_PUBLIC_URL=https://REPLACE_ME_DOMAIN/sign
BACKUP_PUBLIC_URL=https://REPLACE_ME_DOMAIN/backup/api/backup
EXPORT_PUBLIC_URL=https://REPLACE_ME_DOMAIN/export

# --- mail (pod-mail → mail provider SMTP relay) ---
# USER-SUPPLIED and never generated: this is the provider's own secret key
# (Plunk: `sk_…`). The sending domain must be verified with the provider and
# carry SPF + DKIM (ideally DMARC) DNS records, or mail is rejected/spammed.
PLUNK_SMTP_PASSWORD=REPLACE_ME_PLUNK_SMTP_PASSWORD

# --- misc ---
PLATFORM_ADMIN_EMAILS=
# Optional analytics collector (commented out in docker-compose.yaml):
# POSTHOG_HOST=
# POSTHOG_API_KEY=
