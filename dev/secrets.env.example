# ─────────────────────────────────────────────────────────────────────────────
# secrets.env.example — the SERVER-side deployment secrets file (keys documented,
# values deliberately absent). This file is a template and is safe to commit.
#
# The real file lives OUTSIDE this repository, root-owned and unreadable by others:
#     /etc/wedidwork/secrets.env        (chmod 600, chown root:root)
# A real `secrets.env` is gitignored anywhere in the tree — never commit one.
#
# WHY a file outside the repo:
#   * HULY_SHARED_SECRET must be STABLE across redeploys (it signs tokens for every
#     token-checking service —
#     changing it logs every user out and invalidates all API tokens). A file the
#     repo regenerates cannot provide that.
#   * Nothing sensitive should ever be repo-resident, so a `git pull` on the server
#     can never overwrite or expose it.
#
# HOW TO INSTALL (copy-paste, on the server):
#   sudo install -d -m 750 /etc/wedidwork
#   sudo tee /etc/wedidwork/secrets.env >/dev/null <<'EOF'
#   HULY_SHARED_SECRET=<paste a 64-char hex value: openssl rand -hex 32>
#   PLUNK_SMTP_PASSWORD=<your Plunk secret key, sk_…>
#   DB_CR_URL=postgresql://<user>:<password>@<host>:26257/<db>?sslmode=<mode>
#   DB_URL_PG=postgres://<user>:<password>@<host>:5432/<db>
#   MONGO_URL=mongodb://<host>:27017?compressors=snappy
#   STORAGE_CONFIG="datalake|http://<host>:4030?accessKey=<key>&secretKey=<secret>"
#   BACKUP_STORAGE_CONFIG="minio|<host>:9000?accessKey=<key>&secretKey=<secret>"
#   EOF
#   sudo chown root:root /etc/wedidwork/secrets.env
#   sudo chmod 600 /etc/wedidwork/secrets.env
#
# HOW TO INJECT IT (pick one — both are read by compose's ${VAR} interpolation,
# which prefers the shell environment over the auto-loaded dev/.env):
#   * systemd unit:
#       EnvironmentFile=/etc/wedidwork/secrets.env
#   * deploy script / shell:
#       set -a; . /etc/wedidwork/secrets.env; set +a
#       rush docker:up:min
#
# NOTE: plain `docker compose` (not Swarm) has no Docker secrets feature — a
# root-only env file is the mechanism here.
# NOTE: any variable that is neither exported nor present in dev/.env interpolates
# to an EMPTY string with only a warning from compose, and the services' startup
# guards fire on undefined values — so inject the complete set, not a subset.
# ─────────────────────────────────────────────────────────────────────────────

# Shared token-signing secret — the single value for EVERY token-checking
# service (SERVER_SECRET / SECRET / STREAM_SERVER_SECRET / HULY_TOKEN_SECRET). Must stay stable; rotate only deliberately.
HULY_SHARED_SECRET=

# Mail provider secret used by the pod-mail (mail) service — Plunk `sk_…`.
# The SOURCE domain must be verified with the provider and carry SPF + DKIM.
PLUNK_SMTP_PASSWORD=

# Database / storage credentials (replace with the real deployment values).
DB_CR_URL=
DB_URL_PG=
MONGO_URL=
STORAGE_CONFIG=
BACKUP_STORAGE_CONFIG=
